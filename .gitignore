*.pem
*.key
*.crt
*.p12
.*
# 「.*」で全ドット始まりが無視される副作用を打ち消すために、
# プロジェクトに必要な隠しフォルダを明示的に無視対象から外す。
!.github/
!.github/**
!.gitignore
!.gitattributes
!.npmrc
!.nvmrc
!.vscode/
!.vscode/**
!.vscode-test
!.eslintrc*
!.editorconfig
!.mailmap
!.mocharc*
!.prettierrc*
!.stylelintrc*
!.devcontainer/
!.devcontainer/**
!.git-blame-ignore-revs
!.gitattributes
!.husky/
!.husky/**
# .build と .vscode/extensions/**/out は別途明示的に無視する
.vscode/extensions/**/out/

# ローカルビルドのログ・作業用メモ (誤ってコミットされやすいので明示的に無視)
build_output*.txt
build-errors.log
compile_errors.txt
COMMIT_MSG*.txt
