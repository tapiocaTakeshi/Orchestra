import {
    SendDisableReason,
    computeSendBlockReason,
    SendPreviewPanel,
    CollapsibleToolBlock,
    MessageSeparator,
} from './components';
import './components/sidebar-chat.css';

// 2) 既存の「送信ボタン disabled」判定箇所の直前で理由を算出し、入力欄の直下に描画
const sendBlockReason = computeSendBlockReason({
    text: inputText,
    isSending,
    isIndexing,
    isUploading,
});
// ...
<SendDisableReason reason={sendBlockReason} />
<button
    type="button"
    onClick={handleRequestPreview}          // ← 直接 submit せず、一旦プレビューを開く
    disabled={sendBlockReason !== null}
    aria-describedby="sidebar-chat-send-disable-reason"
    aria-label="メッセージ送信 (Enter)"
>Send</button>

// 3) 送信前プレビュー差し込み
<SendPreviewPanel
    open={isPreviewOpen}
    text={inputText}
    attachments={attachedFiles.map(f => ({ id: f.path, label: f.name, detail: f.path }))}
    onConfirm={() => { setPreviewOpen(false); actuallySendMessage(); }}
    onCancel={() => setPreviewOpen(false)}
/>

// 4) tool 結果の描画を CollapsibleToolBlock で包む
<CollapsibleToolBlock
    toolName={tool.name}
    status={tool.status}
    summary={tool.firstLineOrSummary}
    rawText={tool.rawText}
>
    {tool.body}
</CollapsibleToolBlock>

// 5) メッセージ ul 内で日付が変わる位置に
<MessageSeparator label={dateLabel} />
// 6) 各メッセージ要素に className="sbc-message" と data-role="user|assistant|error" を付与
<div className="sbc-message" data-role={msg.role} tabIndex={0}>...</div>
