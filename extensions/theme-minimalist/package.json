{
  "name": "theme-minimalist",
  "displayName": "Minimalist Themes",
  "description": "Minimal, low-contrast themes that emphasize whitespace and content over chrome.",
  "version": "1.0.0",
  "publisher": "vscode",
  "license": "MIT",
  "engines": {
    "vscode": "*"
  },
  "categories": [
    "Themes"
  ],
  "contributes": {
    "themes": [
      {
        "id": "Minimalist Light",
        "label": "Minimalist Light",
        "uiTheme": "vs",
        "path": "./themes/minimalist-light-color-theme.json"
      },
      {
        "id": "Minimalist Dark",
        "label": "Minimalist Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/minimalist-dark-color-theme.json"
      }
    ]
  },
  "capabilities": {
    "virtualWorkspaces": true,
    "untrustedWorkspaces": {
      "supported": true
    }
  }
}
