{
  "name": "Minimalist Dark",
  "type": "dark",
  "semanticHighlighting": true,
  "colors": {
    "foreground": "#e6e6e6",
    "focusBorder": "#00000000",
    "contrastBorder": "#00000000",
    "widget.shadow": "#00000040",

    "editor.background": "#111111",
    "editor.foreground": "#e6e6e6",
    "editor.lineHighlightBackground": "#ffffff08",
    "editor.lineHighlightBorder": "#00000000",
    "editor.selectionBackground": "#ffffff1f",
    "editor.inactiveSelectionBackground": "#ffffff10",
    "editorCursor.foreground": "#e6e6e6",
    "editorWhitespace.foreground": "#ffffff14",
    "editorIndentGuide.background1": "#ffffff10",
    "editorIndentGuide.activeBackground1": "#ffffff26",
    "editorLineNumber.foreground": "#ffffff40",
    "editorLineNumber.activeForeground": "#e6e6e6",
    "editorRuler.foreground": "#ffffff10",

    "editorGroup.border": "#ffffff10",
    "editorGroupHeader.tabsBackground": "#111111",
    "editorGroupHeader.tabsBorder": "#00000000",
    "editorGroupHeader.border": "#00000000",

    "tab.activeBackground": "#111111",
    "tab.inactiveBackground": "#111111",
    "tab.activeForeground": "#e6e6e6",
    "tab.inactiveForeground": "#ffffff66",
    "tab.border": "#00000000",
    "tab.activeBorder": "#00000000",
    "tab.activeBorderTop": "#e6e6e6",
    "tab.hoverBackground": "#ffffff08",

    "activityBar.background": "#111111",
    "activityBar.foreground": "#e6e6e6",
    "activityBar.inactiveForeground": "#ffffff66",
    "activityBar.border": "#00000000",
    "activityBar.activeBorder": "#e6e6e6",
    "activityBar.activeBackground": "#00000000",
    "activityBarBadge.background": "#e6e6e6",
    "activityBarBadge.foreground": "#111111",

    "sideBar.background": "#111111",
    "sideBar.foreground": "#e6e6e6",
    "sideBar.border": "#00000000",
    "sideBarTitle.foreground": "#ffffff80",
    "sideBarSectionHeader.background": "#111111",
    "sideBarSectionHeader.foreground": "#ffffff80",
    "sideBarSectionHeader.border": "#00000000",

    "list.hoverBackground": "#ffffff08",
    "list.activeSelectionBackground": "#ffffff14",
    "list.activeSelectionForeground": "#ffffff",
    "list.inactiveSelectionBackground": "#ffffff0a",
    "list.inactiveSelectionForeground": "#e6e6e6",
    "list.focusBackground": "#ffffff14",
    "list.focusOutline": "#00000000",
    "list.highlightForeground": "#ffffff",

    "statusBar.background": "#111111",
    "statusBar.foreground": "#ffffff80",
    "statusBar.border": "#ffffff10",
    "statusBar.noFolderBackground": "#111111",
    "statusBar.debuggingBackground": "#111111",
    "statusBar.debuggingForeground": "#e6e6e6",
    "statusBarItem.hoverBackground": "#ffffff08",
    "statusBarItem.remoteBackground": "#111111",
    "statusBarItem.remoteForeground": "#e6e6e6",

    "titleBar.activeBackground": "#111111",
    "titleBar.activeForeground": "#e6e6e6",
    "titleBar.inactiveBackground": "#111111",
    "titleBar.inactiveForeground": "#ffffff80",
    "titleBar.border": "#00000000",

    "menubar.selectionBackground": "#ffffff10",
    "menu.background": "#1a1a1a",
    "menu.foreground": "#e6e6e6",
    "menu.separatorBackground": "#ffffff14",

    "panel.background": "#111111",
    "panel.border": "#ffffff10",
    "panelTitle.activeForeground": "#e6e6e6",
    "panelTitle.inactiveForeground": "#ffffff66",
    "panelTitle.activeBorder": "#e6e6e6",

    "input.background": "#1a1a1a",
    "input.foreground": "#e6e6e6",
    "input.border": "#ffffff14",
    "input.placeholderForeground": "#ffffff66",
    "inputOption.activeBorder": "#e6e6e6",
    "inputOption.activeBackground": "#ffffff14",

    "dropdown.background": "#1a1a1a",
    "dropdown.foreground": "#e6e6e6",
    "dropdown.border": "#ffffff14",

    "button.background": "#e6e6e6",
    "button.foreground": "#111111",
    "button.hoverBackground": "#ffffff",
    "button.secondaryBackground": "#ffffff14",
    "button.secondaryForeground": "#e6e6e6",
    "button.secondaryHoverBackground": "#ffffff20",

    "badge.background": "#e6e6e6",
    "badge.foreground": "#111111",

    "scrollbar.shadow": "#00000000",
    "scrollbarSlider.background": "#ffffff20",
    "scrollbarSlider.hoverBackground": "#ffffff30",
    "scrollbarSlider.activeBackground": "#ffffff40",

    "terminal.background": "#111111",
    "terminal.foreground": "#e6e6e6",
    "terminalCursor.foreground": "#e6e6e6",

    "breadcrumb.foreground": "#ffffff66",
    "breadcrumb.focusForeground": "#e6e6e6",
    "breadcrumb.activeSelectionForeground": "#e6e6e6",
    "breadcrumbPicker.background": "#1a1a1a",

    "minimap.background": "#111111",

    "notifications.background": "#1a1a1a",
    "notifications.foreground": "#e6e6e6",
    "notifications.border": "#ffffff10"
  },
  "tokenColors": [
    {
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": { "foreground": "#ffffff55", "fontStyle": "italic" }
    },
    {
      "scope": ["string", "string.quoted", "punctuation.definition.string"],
      "settings": { "foreground": "#e6e6e6" }
    },
    {
      "scope": ["constant.numeric", "constant.language", "constant.character"],
      "settings": { "foreground": "#e6e6e6" }
    },
    {
      "scope": ["keyword", "storage", "storage.type", "keyword.control"],
      "settings": { "foreground": "#ffffff", "fontStyle": "bold" }
    },
    {
      "scope": ["entity.name.function", "support.function", "meta.function-call"],
      "settings": { "foreground": "#e6e6e6" }
    },
    {
      "scope": ["entity.name.type", "entity.name.class", "support.class", "support.type"],
      "settings": { "foreground": "#ffffff", "fontStyle": "bold" }
    },
    {
      "scope": ["variable", "variable.other", "variable.parameter"],
      "settings": { "foreground": "#e6e6e6" }
    },
    {
      "scope": ["entity.other.attribute-name", "entity.name.tag"],
      "settings": { "foreground": "#e6e6e6" }
    },
    {
      "scope": ["invalid", "invalid.illegal"],
      "settings": { "foreground": "#ff6b6b" }
    },
    {
      "scope": ["markup.heading"],
      "settings": { "foreground": "#ffffff", "fontStyle": "bold" }
    },
    {
      "scope": ["markup.bold"],
      "settings": { "fontStyle": "bold" }
    },
    {
      "scope": ["markup.italic"],
      "settings": { "fontStyle": "italic" }
    },
    {
      "scope": ["markup.quote"],
      "settings": { "foreground": "#ffffff80", "fontStyle": "italic" }
    }
  ]
}
