{
  "name": "Minimalist Light",
  "type": "light",
  "semanticHighlighting": true,
  "colors": {
    "foreground": "#1f1f1f",
    "focusBorder": "#00000000",
    "contrastBorder": "#00000000",
    "widget.shadow": "#00000010",

    "editor.background": "#fafafa",
    "editor.foreground": "#1f1f1f",
    "editor.lineHighlightBackground": "#00000008",
    "editor.lineHighlightBorder": "#00000000",
    "editor.selectionBackground": "#1f1f1f1a",
    "editor.inactiveSelectionBackground": "#1f1f1f0d",
    "editorCursor.foreground": "#1f1f1f",
    "editorWhitespace.foreground": "#00000014",
    "editorIndentGuide.background1": "#00000010",
    "editorIndentGuide.activeBackground1": "#00000026",
    "editorLineNumber.foreground": "#00000040",
    "editorLineNumber.activeForeground": "#1f1f1f",
    "editorRuler.foreground": "#00000010",

    "editorGroup.border": "#00000010",
    "editorGroupHeader.tabsBackground": "#fafafa",
    "editorGroupHeader.tabsBorder": "#00000000",
    "editorGroupHeader.border": "#00000000",

    "tab.activeBackground": "#fafafa",
    "tab.inactiveBackground": "#fafafa",
    "tab.activeForeground": "#1f1f1f",
    "tab.inactiveForeground": "#00000080",
    "tab.border": "#00000000",
    "tab.activeBorder": "#00000000",
    "tab.activeBorderTop": "#1f1f1f",
    "tab.hoverBackground": "#00000008",

    "activityBar.background": "#fafafa",
    "activityBar.foreground": "#1f1f1f",
    "activityBar.inactiveForeground": "#00000066",
    "activityBar.border": "#00000000",
    "activityBar.activeBorder": "#1f1f1f",
    "activityBar.activeBackground": "#00000000",
    "activityBarBadge.background": "#1f1f1f",
    "activityBarBadge.foreground": "#fafafa",

    "sideBar.background": "#fafafa",
    "sideBar.foreground": "#1f1f1f",
    "sideBar.border": "#00000000",
    "sideBarTitle.foreground": "#00000080",
    "sideBarSectionHeader.background": "#fafafa",
    "sideBarSectionHeader.foreground": "#00000080",
    "sideBarSectionHeader.border": "#00000000",

    "list.hoverBackground": "#00000008",
    "list.activeSelectionBackground": "#00000010",
    "list.activeSelectionForeground": "#1f1f1f",
    "list.inactiveSelectionBackground": "#00000008",
    "list.inactiveSelectionForeground": "#1f1f1f",
    "list.focusBackground": "#00000010",
    "list.focusOutline": "#00000000",
    "list.highlightForeground": "#1f1f1f",

    "statusBar.background": "#fafafa",
    "statusBar.foreground": "#00000080",
    "statusBar.border": "#00000010",
    "statusBar.noFolderBackground": "#fafafa",
    "statusBar.debuggingBackground": "#fafafa",
    "statusBar.debuggingForeground": "#1f1f1f",
    "statusBarItem.hoverBackground": "#00000008",
    "statusBarItem.remoteBackground": "#fafafa",
    "statusBarItem.remoteForeground": "#1f1f1f",

    "titleBar.activeBackground": "#fafafa",
    "titleBar.activeForeground": "#1f1f1f",
    "titleBar.inactiveBackground": "#fafafa",
    "titleBar.inactiveForeground": "#00000080",
    "titleBar.border": "#00000000",

    "menubar.selectionBackground": "#00000008",
    "menu.background": "#ffffff",
    "menu.foreground": "#1f1f1f",
    "menu.separatorBackground": "#00000010",

    "panel.background": "#fafafa",
    "panel.border": "#00000010",
    "panelTitle.activeForeground": "#1f1f1f",
    "panelTitle.inactiveForeground": "#00000080",
    "panelTitle.activeBorder": "#1f1f1f",

    "input.background": "#ffffff",
    "input.foreground": "#1f1f1f",
    "input.border": "#00000014",
    "input.placeholderForeground": "#00000066",
    "inputOption.activeBorder": "#1f1f1f",
    "inputOption.activeBackground": "#00000010",

    "dropdown.background": "#ffffff",
    "dropdown.foreground": "#1f1f1f",
    "dropdown.border": "#00000014",

    "button.background": "#1f1f1f",
    "button.foreground": "#fafafa",
    "button.hoverBackground": "#000000",
    "button.secondaryBackground": "#00000010",
    "button.secondaryForeground": "#1f1f1f",
    "button.secondaryHoverBackground": "#00000018",

    "badge.background": "#1f1f1f",
    "badge.foreground": "#fafafa",

    "scrollbar.shadow": "#00000000",
    "scrollbarSlider.background": "#00000020",
    "scrollbarSlider.hoverBackground": "#00000030",
    "scrollbarSlider.activeBackground": "#00000040",

    "terminal.background": "#fafafa",
    "terminal.foreground": "#1f1f1f",
    "terminalCursor.foreground": "#1f1f1f",

    "breadcrumb.foreground": "#00000066",
    "breadcrumb.focusForeground": "#1f1f1f",
    "breadcrumb.activeSelectionForeground": "#1f1f1f",
    "breadcrumbPicker.background": "#ffffff",

    "minimap.background": "#fafafa",

    "notifications.background": "#ffffff",
    "notifications.foreground": "#1f1f1f",
    "notifications.border": "#00000010"
  },
  "tokenColors": [
    {
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": { "foreground": "#00000066", "fontStyle": "italic" }
    },
    {
      "scope": ["string", "string.quoted", "punctuation.definition.string"],
      "settings": { "foreground": "#1f1f1f" }
    },
    {
      "scope": ["constant.numeric", "constant.language", "constant.character"],
      "settings": { "foreground": "#1f1f1f" }
    },
    {
      "scope": ["keyword", "storage", "storage.type", "keyword.control"],
      "settings": { "foreground": "#1f1f1f", "fontStyle": "bold" }
    },
    {
      "scope": ["entity.name.function", "support.function", "meta.function-call"],
      "settings": { "foreground": "#1f1f1f" }
    },
    {
      "scope": ["entity.name.type", "entity.name.class", "support.class", "support.type"],
      "settings": { "foreground": "#1f1f1f", "fontStyle": "bold" }
    },
    {
      "scope": ["variable", "variable.other", "variable.parameter"],
      "settings": { "foreground": "#1f1f1f" }
    },
    {
      "scope": ["entity.other.attribute-name", "entity.name.tag"],
      "settings": { "foreground": "#1f1f1f" }
    },
    {
      "scope": ["invalid", "invalid.illegal"],
      "settings": { "foreground": "#b00020" }
    },
    {
      "scope": ["markup.heading"],
      "settings": { "foreground": "#1f1f1f", "fontStyle": "bold" }
    },
    {
      "scope": ["markup.bold"],
      "settings": { "fontStyle": "bold" }
    },
    {
      "scope": ["markup.italic"],
      "settings": { "fontStyle": "italic" }
    },
    {
      "scope": ["markup.quote"],
      "settings": { "foreground": "#00000080", "fontStyle": "italic" }
    }
  ]
}
