{
  "name": "Minimal Dark",
  "type": "dark",
  "semanticHighlighting": true,
  "colors": {
    "editor.background": "#161616",
    "editor.foreground": "#E6E6E6",
    "editor.lineHighlightBackground": "#1E1E1E",
    "editor.lineHighlightBorder": "#00000000",
    "editor.selectionBackground": "#2E2E2E",
    "editor.inactiveSelectionBackground": "#262626",
    "editor.wordHighlightBackground": "#242424",
    "editor.wordHighlightStrongBackground": "#2C2C2C",
    "editor.findMatchBackground": "#2E2E2E",
    "editor.findMatchHighlightBackground": "#242424",
    "editor.hoverHighlightBackground": "#1E1E1E",
    "editorCursor.foreground": "#E6E6E6",
    "editorWhitespace.foreground": "#2A2A2A",
    "editorIndentGuide.background1": "#222222",
    "editorIndentGuide.activeBackground1": "#3A3A3A",
    "editorLineNumber.foreground": "#4A4A4A",
    "editorLineNumber.activeForeground": "#E6E6E6",
    "editorRuler.foreground": "#222222",
    "editorBracketMatch.background": "#00000000",
    "editorBracketMatch.border": "#4A4A4A",

    "editorGroupHeader.tabsBackground": "#141414",
    "editorGroupHeader.tabsBorder": "#1F1F1F",
    "editorGroup.border": "#1F1F1F",

    "tab.activeBackground": "#161616",
    "tab.activeForeground": "#E6E6E6",
    "tab.inactiveBackground": "#141414",
    "tab.inactiveForeground": "#8A8A8A",
    "tab.border": "#1F1F1F",
    "tab.activeBorder": "#161616",
    "tab.activeBorderTop": "#E6E6E6",
    "tab.hoverBackground": "#1E1E1E",

    "activityBar.background": "#141414",
    "activityBar.foreground": "#E6E6E6",
    "activityBar.inactiveForeground": "#6A6A6A",
    "activityBar.border": "#1F1F1F",
    "activityBar.activeBorder": "#E6E6E6",
    "activityBarBadge.background": "#E6E6E6",
    "activityBarBadge.foreground": "#161616",

    "sideBar.background": "#141414",
    "sideBar.foreground": "#C8C8C8",
    "sideBar.border": "#1F1F1F",
    "sideBarTitle.foreground": "#E6E6E6",
    "sideBarSectionHeader.background": "#141414",
    "sideBarSectionHeader.foreground": "#E6E6E6",
    "sideBarSectionHeader.border": "#1F1F1F",

    "list.activeSelectionBackground": "#262626",
    "list.activeSelectionForeground": "#E6E6E6",
    "list.inactiveSelectionBackground": "#1E1E1E",
    "list.inactiveSelectionForeground": "#E6E6E6",
    "list.hoverBackground": "#1E1E1E",
    "list.hoverForeground": "#E6E6E6",
    "list.focusBackground": "#262626",
    "list.highlightForeground": "#E6E6E6",

    "statusBar.background": "#141414",
    "statusBar.foreground": "#C8C8C8",
    "statusBar.border": "#1F1F1F",
    "statusBar.noFolderBackground": "#141414",
    "statusBar.debuggingBackground": "#141414",
    "statusBar.debuggingForeground": "#E6E6E6",
    "statusBarItem.hoverBackground": "#1E1E1E",
    "statusBarItem.remoteBackground": "#141414",
    "statusBarItem.remoteForeground": "#C8C8C8",

    "titleBar.activeBackground": "#141414",
    "titleBar.activeForeground": "#E6E6E6",
    "titleBar.inactiveBackground": "#101010",
    "titleBar.inactiveForeground": "#8A8A8A",
    "titleBar.border": "#1F1F1F",

    "menu.background": "#161616",
    "menu.foreground": "#E6E6E6",
    "menu.selectionBackground": "#262626",
    "menu.selectionForeground": "#E6E6E6",
    "menu.border": "#1F1F1F",

    "panel.background": "#161616",
    "panel.border": "#1F1F1F",
    "panelTitle.activeForeground": "#E6E6E6",
    "panelTitle.inactiveForeground": "#8A8A8A",
    "panelTitle.activeBorder": "#E6E6E6",

    "input.background": "#1A1A1A",
    "input.foreground": "#E6E6E6",
    "input.border": "#2A2A2A",
    "input.placeholderForeground": "#6A6A6A",
    "inputOption.activeBorder": "#E6E6E6",
    "dropdown.background": "#1A1A1A",
    "dropdown.foreground": "#E6E6E6",
    "dropdown.border": "#2A2A2A",

    "button.background": "#E6E6E6",
    "button.foreground": "#161616",
    "button.hoverBackground": "#FFFFFF",
    "button.secondaryBackground": "#262626",
    "button.secondaryForeground": "#E6E6E6",
    "button.secondaryHoverBackground": "#333333",

    "badge.background": "#E6E6E6",
    "badge.foreground": "#161616",

    "scrollbar.shadow": "#00000000",
    "scrollbarSlider.background": "#FFFFFF14",
    "scrollbarSlider.hoverBackground": "#FFFFFF22",
    "scrollbarSlider.activeBackground": "#FFFFFF33",

    "focusBorder": "#3A3A3A",
    "foreground": "#E6E6E6",
    "widget.shadow": "#00000066",
    "selection.background": "#2E2E2E",
    "errorForeground": "#E08A8A",
    "descriptionForeground": "#8A8A8A",
    "icon.foreground": "#C8C8C8",
    "breadcrumb.background": "#161616",
    "breadcrumb.foreground": "#8A8A8A",
    "breadcrumb.focusForeground": "#E6E6E6",
    "breadcrumb.activeSelectionForeground": "#E6E6E6"
  },
  "tokenColors": [
    {
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": { "foreground": "#6A6A6A", "fontStyle": "italic" }
    },
    {
      "scope": ["string", "constant.other.symbol"],
      "settings": { "foreground": "#9EBF9E" }
    },
    {
      "scope": ["constant.numeric", "constant.language", "constant.character"],
      "settings": { "foreground": "#D2A878" }
    },
    {
      "scope": ["keyword", "storage", "storage.type", "keyword.control"],
      "settings": { "foreground": "#E6E6E6", "fontStyle": "bold" }
    },
    {
      "scope": ["entity.name.function", "support.function", "meta.function-call entity.name.function"],
      "settings": { "foreground": "#A8C5E6" }
    },
    {
      "scope": ["entity.name.type", "entity.name.class", "support.class", "support.type"],
      "settings": { "foreground": "#C8A8E6" }
    },
    {
      "scope": ["variable", "variable.other.readwrite", "variable.parameter"],
      "settings": { "foreground": "#E6E6E6" }
    },
    {
      "scope": ["punctuation", "meta.brace", "meta.delimiter"],
      "settings": { "foreground": "#A8A8A8" }
    },
    {
      "scope": ["entity.other.attribute-name", "meta.tag entity.name.tag"],
      "settings": { "foreground": "#C8C8C8" }
    },
    {
      "scope": ["markup.heading", "markup.bold"],
      "settings": { "foreground": "#FFFFFF", "fontStyle": "bold" }
    },
    {
      "scope": ["markup.italic"],
      "settings": { "fontStyle": "italic" }
    },
    {
      "scope": ["invalid", "invalid.illegal"],
      "settings": { "foreground": "#E08A8A" }
    }
  ]
}
