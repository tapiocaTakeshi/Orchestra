{
  "name": "Minimal Light",
  "type": "light",
  "semanticHighlighting": true,
  "colors": {
    "editor.background": "#FAFAFA",
    "editor.foreground": "#1F1F1F",
    "editor.lineHighlightBackground": "#F0F0F0",
    "editor.lineHighlightBorder": "#00000000",
    "editor.selectionBackground": "#D6D6D6",
    "editor.inactiveSelectionBackground": "#E5E5E5",
    "editor.wordHighlightBackground": "#EAEAEA",
    "editor.wordHighlightStrongBackground": "#DDDDDD",
    "editor.findMatchBackground": "#E0E0E0",
    "editor.findMatchHighlightBackground": "#EBEBEB",
    "editor.hoverHighlightBackground": "#EFEFEF",
    "editorCursor.foreground": "#1F1F1F",
    "editorWhitespace.foreground": "#D8D8D8",
    "editorIndentGuide.background1": "#EDEDED",
    "editorIndentGuide.activeBackground1": "#C8C8C8",
    "editorLineNumber.foreground": "#BFBFBF",
    "editorLineNumber.activeForeground": "#1F1F1F",
    "editorRuler.foreground": "#EDEDED",
    "editorBracketMatch.background": "#00000000",
    "editorBracketMatch.border": "#BFBFBF",

    "editorGroupHeader.tabsBackground": "#F4F4F4",
    "editorGroupHeader.tabsBorder": "#EAEAEA",
    "editorGroup.border": "#EAEAEA",

    "tab.activeBackground": "#FAFAFA",
    "tab.activeForeground": "#1F1F1F",
    "tab.inactiveBackground": "#F4F4F4",
    "tab.inactiveForeground": "#7A7A7A",
    "tab.border": "#EAEAEA",
    "tab.activeBorder": "#FAFAFA",
    "tab.activeBorderTop": "#1F1F1F",
    "tab.hoverBackground": "#EFEFEF",

    "activityBar.background": "#FAFAFA",
    "activityBar.foreground": "#1F1F1F",
    "activityBar.inactiveForeground": "#A8A8A8",
    "activityBar.border": "#EAEAEA",
    "activityBar.activeBorder": "#1F1F1F",
    "activityBarBadge.background": "#1F1F1F",
    "activityBarBadge.foreground": "#FFFFFF",

    "sideBar.background": "#F7F7F7",
    "sideBar.foreground": "#3A3A3A",
    "sideBar.border": "#EAEAEA",
    "sideBarTitle.foreground": "#1F1F1F",
    "sideBarSectionHeader.background": "#F7F7F7",
    "sideBarSectionHeader.foreground": "#1F1F1F",
    "sideBarSectionHeader.border": "#EAEAEA",

    "list.activeSelectionBackground": "#E5E5E5",
    "list.activeSelectionForeground": "#1F1F1F",
    "list.inactiveSelectionBackground": "#EDEDED",
    "list.inactiveSelectionForeground": "#1F1F1F",
    "list.hoverBackground": "#EFEFEF",
    "list.hoverForeground": "#1F1F1F",
    "list.focusBackground": "#E5E5E5",
    "list.highlightForeground": "#1F1F1F",

    "statusBar.background": "#FAFAFA",
    "statusBar.foreground": "#3A3A3A",
    "statusBar.border": "#EAEAEA",
    "statusBar.noFolderBackground": "#FAFAFA",
    "statusBar.debuggingBackground": "#FAFAFA",
    "statusBar.debuggingForeground": "#1F1F1F",
    "statusBarItem.hoverBackground": "#EFEFEF",
    "statusBarItem.remoteBackground": "#FAFAFA",
    "statusBarItem.remoteForeground": "#3A3A3A",

    "titleBar.activeBackground": "#FAFAFA",
    "titleBar.activeForeground": "#1F1F1F",
    "titleBar.inactiveBackground": "#F4F4F4",
    "titleBar.inactiveForeground": "#7A7A7A",
    "titleBar.border": "#EAEAEA",

    "menu.background": "#FAFAFA",
    "menu.foreground": "#1F1F1F",
    "menu.selectionBackground": "#E5E5E5",
    "menu.selectionForeground": "#1F1F1F",
    "menu.border": "#EAEAEA",

    "panel.background": "#FAFAFA",
    "panel.border": "#EAEAEA",
    "panelTitle.activeForeground": "#1F1F1F",
    "panelTitle.inactiveForeground": "#7A7A7A",
    "panelTitle.activeBorder": "#1F1F1F",

    "input.background": "#FFFFFF",
    "input.foreground": "#1F1F1F",
    "input.border": "#DCDCDC",
    "input.placeholderForeground": "#A8A8A8",
    "inputOption.activeBorder": "#1F1F1F",
    "dropdown.background": "#FFFFFF",
    "dropdown.foreground": "#1F1F1F",
    "dropdown.border": "#DCDCDC",

    "button.background": "#1F1F1F",
    "button.foreground": "#FFFFFF",
    "button.hoverBackground": "#3A3A3A",
    "button.secondaryBackground": "#EDEDED",
    "button.secondaryForeground": "#1F1F1F",
    "button.secondaryHoverBackground": "#E0E0E0",

    "badge.background": "#1F1F1F",
    "badge.foreground": "#FFFFFF",

    "scrollbar.shadow": "#00000000",
    "scrollbarSlider.background": "#00000022",
    "scrollbarSlider.hoverBackground": "#00000033",
    "scrollbarSlider.activeBackground": "#00000044",

    "focusBorder": "#BFBFBF",
    "foreground": "#1F1F1F",
    "widget.shadow": "#0000000F",
    "selection.background": "#D6D6D6",
    "errorForeground": "#A33A3A",
    "descriptionForeground": "#7A7A7A",
    "icon.foreground": "#3A3A3A",
    "breadcrumb.background": "#FAFAFA",
    "breadcrumb.foreground": "#7A7A7A",
    "breadcrumb.focusForeground": "#1F1F1F",
    "breadcrumb.activeSelectionForeground": "#1F1F1F"
  },
  "tokenColors": [
    {
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": { "foreground": "#9A9A9A", "fontStyle": "italic" }
    },
    {
      "scope": ["string", "constant.other.symbol"],
      "settings": { "foreground": "#3A6E3A" }
    },
    {
      "scope": ["constant.numeric", "constant.language", "constant.character"],
      "settings": { "foreground": "#7A4A1F" }
    },
    {
      "scope": ["keyword", "storage", "storage.type", "keyword.control"],
      "settings": { "foreground": "#1F1F1F", "fontStyle": "bold" }
    },
    {
      "scope": ["entity.name.function", "support.function", "meta.function-call entity.name.function"],
      "settings": { "foreground": "#1F4A7A" }
    },
    {
      "scope": ["entity.name.type", "entity.name.class", "support.class", "support.type"],
      "settings": { "foreground": "#5A2E7A" }
    },
    {
      "scope": ["variable", "variable.other.readwrite", "variable.parameter"],
      "settings": { "foreground": "#1F1F1F" }
    },
    {
      "scope": ["punctuation", "meta.brace", "meta.delimiter"],
      "settings": { "foreground": "#5A5A5A" }
    },
    {
      "scope": ["entity.other.attribute-name", "meta.tag entity.name.tag"],
      "settings": { "foreground": "#3A3A3A" }
    },
    {
      "scope": ["markup.heading", "markup.bold"],
      "settings": { "foreground": "#1F1F1F", "fontStyle": "bold" }
    },
    {
      "scope": ["markup.italic"],
      "settings": { "fontStyle": "italic" }
    },
    {
      "scope": ["invalid", "invalid.illegal"],
      "settings": { "foreground": "#A33A3A" }
    }
  ]
}
