{
  "name": "Minimal Light",
  "type": "light",
  "semanticHighlighting": true,
  "colors": {
    "foreground": "#1f2328",
    "focusBorder": "#0a66c2",
    "errorForeground": "#cf222e",

    "editor.background": "#ffffff",
    "editor.foreground": "#1f2328",
    "editor.lineHighlightBackground": "#f6f8fa",
    "editor.lineHighlightBorder": "#00000000",
    "editor.selectionBackground": "#dbe7f6",
    "editor.inactiveSelectionBackground": "#eaeef2",
    "editor.findMatchBackground": "#fff8c5",
    "editor.findMatchHighlightBackground": "#fff8c580",
    "editorCursor.foreground": "#0a66c2",
    "editorWhitespace.foreground": "#d0d7de",
    "editorIndentGuide.background1": "#eaeef2",
    "editorIndentGuide.activeBackground1": "#d0d7de",
    "editorLineNumber.foreground": "#afb8c1",
    "editorLineNumber.activeForeground": "#1f2328",
    "editorRuler.foreground": "#eaeef2",

    "editorGutter.background": "#ffffff",
    "editorGutter.modifiedBackground": "#bf8700",
    "editorGutter.addedBackground": "#1a7f37",
    "editorGutter.deletedBackground": "#cf222e",

    "editorWidget.background": "#ffffff",
    "editorWidget.border": "#eaeef2",
    "editorSuggestWidget.background": "#ffffff",
    "editorSuggestWidget.border": "#eaeef2",
    "editorSuggestWidget.selectedBackground": "#f6f8fa",

    "activityBar.background": "#ffffff",
    "activityBar.foreground": "#1f2328",
    "activityBar.inactiveForeground": "#afb8c1",
    "activityBar.border": "#eaeef2",
    "activityBarBadge.background": "#0a66c2",
    "activityBarBadge.foreground": "#ffffff",

    "sideBar.background": "#fbfcfd",
    "sideBar.foreground": "#1f2328",
    "sideBar.border": "#eaeef2",
    "sideBarTitle.foreground": "#656d76",
    "sideBarSectionHeader.background": "#fbfcfd",
    "sideBarSectionHeader.foreground": "#656d76",
    "sideBarSectionHeader.border": "#eaeef2",

    "list.hoverBackground": "#f6f8fa",
    "list.activeSelectionBackground": "#eaeef2",
    "list.activeSelectionForeground": "#1f2328",
    "list.inactiveSelectionBackground": "#f6f8fa",
    "list.inactiveSelectionForeground": "#1f2328",
    "list.focusBackground": "#eaeef2",
    "list.highlightForeground": "#0a66c2",

    "statusBar.background": "#ffffff",
    "statusBar.foreground": "#656d76",
    "statusBar.border": "#eaeef2",
    "statusBar.noFolderBackground": "#ffffff",
    "statusBar.debuggingBackground": "#ffffff",
    "statusBar.debuggingForeground": "#0a66c2",
    "statusBarItem.hoverBackground": "#f6f8fa",
    "statusBarItem.remoteBackground": "#ffffff",
    "statusBarItem.remoteForeground": "#656d76",

    "titleBar.activeBackground": "#ffffff",
    "titleBar.activeForeground": "#1f2328",
    "titleBar.inactiveBackground": "#ffffff",
    "titleBar.inactiveForeground": "#afb8c1",
    "titleBar.border": "#eaeef2",

    "tab.activeBackground": "#ffffff",
    "tab.activeForeground": "#1f2328",
    "tab.activeBorderTop": "#0a66c2",
    "tab.activeBorder": "#ffffff",
    "tab.inactiveBackground": "#fbfcfd",
    "tab.inactiveForeground": "#656d76",
    "tab.border": "#eaeef2",
    "tab.hoverBackground": "#f6f8fa",
    "editorGroupHeader.tabsBackground": "#fbfcfd",
    "editorGroupHeader.tabsBorder": "#eaeef2",
    "editorGroupHeader.border": "#eaeef2",

    "panel.background": "#ffffff",
    "panel.border": "#eaeef2",
    "panelTitle.activeForeground": "#1f2328",
    "panelTitle.inactiveForeground": "#656d76",
    "panelTitle.activeBorder": "#0a66c2",

    "input.background": "#ffffff",
    "input.foreground": "#1f2328",
    "input.border": "#d0d7de",
    "input.placeholderForeground": "#afb8c1",
    "inputOption.activeBorder": "#0a66c2",
    "inputOption.activeBackground": "#dbe7f6",

    "button.background": "#0a66c2",
    "button.foreground": "#ffffff",
    "button.hoverBackground": "#0958ab",
    "button.secondaryBackground": "#f6f8fa",
    "button.secondaryForeground": "#1f2328",
    "button.secondaryHoverBackground": "#eaeef2",

    "badge.background": "#eaeef2",
    "badge.foreground": "#1f2328",

    "scrollbar.shadow": "#00000000",
    "scrollbarSlider.background": "#afb8c155",
    "scrollbarSlider.hoverBackground": "#afb8c188",
    "scrollbarSlider.activeBackground": "#656d76aa",

    "terminal.background": "#ffffff",
    "terminal.foreground": "#1f2328",
    "terminalCursor.foreground": "#0a66c2"
  },
  "tokenColors": [
    {
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": { "foreground": "#8c959f", "fontStyle": "italic" }
    },
    {
      "scope": ["string", "constant.other.symbol"],
      "settings": { "foreground": "#0a3069" }
    },
    {
      "scope": ["constant.numeric", "constant.language"],
      "settings": { "foreground": "#0550ae" }
    },
    {
      "scope": ["keyword", "storage", "storage.type"],
      "settings": { "foreground": "#cf222e" }
    },
    {
      "scope": ["entity.name.function", "support.function"],
      "settings": { "foreground": "#8250df" }
    },
    {
      "scope": ["entity.name.type", "entity.name.class", "support.class", "support.type"],
      "settings": { "foreground": "#953800" }
    },
    {
      "scope": ["variable", "variable.parameter"],
      "settings": { "foreground": "#1f2328" }
    },
    {
      "scope": ["entity.name.tag"],
      "settings": { "foreground": "#116329" }
    },
    {
      "scope": ["entity.other.attribute-name"],
      "settings": { "foreground": "#0550ae" }
    },
    {
      "scope": ["markup.heading"],
      "settings": { "foreground": "#0550ae", "fontStyle": "bold" }
    },
    {
      "scope": ["markup.italic"],
      "settings": { "fontStyle": "italic" }
    },
    {
      "scope": ["markup.bold"],
      "settings": { "fontStyle": "bold" }
    }
  ]
}
