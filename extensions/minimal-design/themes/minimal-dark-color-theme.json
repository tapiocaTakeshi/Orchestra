{
  "name": "Minimal Dark",
  "type": "dark",
  "semanticHighlighting": true,
  "colors": {
    "foreground": "#E6EDF3",
    "focusBorder": "#0A84FF",
    "errorForeground": "#FF6A69",
    "descriptionForeground": "#8B949E",

    "editor.background": "#0E1116",
    "editor.foreground": "#E6EDF3",
    "editor.lineHighlightBackground": "#0E1116",
    "editor.lineHighlightBorder": "#0E1116",
    "editor.selectionBackground": "#0A84FF33",
    "editor.inactiveSelectionBackground": "#0A84FF1A",
    "editor.findMatchBackground": "#0A84FF55",
    "editor.findMatchHighlightBackground": "#0A84FF22",
    "editorCursor.foreground": "#0A84FF",
    "editorWhitespace.foreground": "#0E1116",
    "editorIndentGuide.background1": "#0E1116",
    "editorIndentGuide.activeBackground1": "#0E1116",
    "editorLineNumber.foreground": "#3B424B",
    "editorLineNumber.activeForeground": "#E6EDF3",
    "editorBracketMatch.background": "#0E1116",
    "editorBracketMatch.border": "#3B424B",

    "editorGroupHeader.tabsBackground": "#0E1116",
    "editorGroupHeader.tabsBorder": "#0E1116",
    "editorGroupHeader.border": "#0E1116",
    "editorGroup.border": "#161B22",

    "tab.activeBackground": "#0E1116",
    "tab.inactiveBackground": "#0E1116",
    "tab.activeForeground": "#E6EDF3",
    "tab.inactiveForeground": "#6E7681",
    "tab.border": "#0E1116",
    "tab.activeBorder": "#0E1116",
    "tab.activeBorderTop": "#0A84FF",
    "tab.hoverBackground": "#161B22",
    "tab.unfocusedHoverBackground": "#161B22",

    "titleBar.activeBackground": "#0E1116",
    "titleBar.activeForeground": "#E6EDF3",
    "titleBar.inactiveBackground": "#0E1116",
    "titleBar.inactiveForeground": "#6E7681",
    "titleBar.border": "#0E1116",

    "activityBar.background": "#0E1116",
    "activityBar.foreground": "#E6EDF3",
    "activityBar.inactiveForeground": "#6E7681",
    "activityBar.border": "#0E1116",
    "activityBar.activeBorder": "#0A84FF",
    "activityBarBadge.background": "#0A84FF",
    "activityBarBadge.foreground": "#FFFFFF",

    "sideBar.background": "#0B0E13",
    "sideBar.foreground": "#E6EDF3",
    "sideBar.border": "#0B0E13",
    "sideBarTitle.foreground": "#8B949E",
    "sideBarSectionHeader.background": "#0B0E13",
    "sideBarSectionHeader.foreground": "#8B949E",
    "sideBarSectionHeader.border": "#0B0E13",

    "list.activeSelectionBackground": "#0A84FF26",
    "list.activeSelectionForeground": "#E6EDF3",
    "list.inactiveSelectionBackground": "#0A84FF1A",
    "list.inactiveSelectionForeground": "#E6EDF3",
    "list.hoverBackground": "#161B22",
    "list.focusBackground": "#0A84FF26",
    "list.highlightForeground": "#0A84FF",

    "statusBar.background": "#0E1116",
    "statusBar.foreground": "#8B949E",
    "statusBar.border": "#161B22",
    "statusBar.noFolderBackground": "#0E1116",
    "statusBar.debuggingBackground": "#0E1116",
    "statusBar.debuggingForeground": "#0A84FF",
    "statusBarItem.remoteBackground": "#0E1116",
    "statusBarItem.remoteForeground": "#0A84FF",
    "statusBarItem.hoverBackground": "#161B22",

    "panel.background": "#0E1116",
    "panel.border": "#161B22",
    "panelTitle.activeForeground": "#E6EDF3",
    "panelTitle.inactiveForeground": "#6E7681",
    "panelTitle.activeBorder": "#0A84FF",

    "input.background": "#0B0E13",
    "input.foreground": "#E6EDF3",
    "input.border": "#3B424B",
    "input.placeholderForeground": "#6E7681",
    "inputOption.activeBorder": "#0A84FF",

    "dropdown.background": "#0B0E13",
    "dropdown.foreground": "#E6EDF3",
    "dropdown.border": "#3B424B",

    "button.background": "#0A84FF",
    "button.foreground": "#FFFFFF",
    "button.hoverBackground": "#0072E0",
    "button.secondaryBackground": "#161B22",
    "button.secondaryForeground": "#E6EDF3",
    "button.secondaryHoverBackground": "#21262D",

    "scrollbar.shadow": "#0E1116",
    "scrollbarSlider.background": "#E6EDF314",
    "scrollbarSlider.hoverBackground": "#E6EDF326",
    "scrollbarSlider.activeBackground": "#E6EDF33A",

    "badge.background": "#0A84FF",
    "badge.foreground": "#FFFFFF",

    "widget.shadow": "#00000059",
    "editorWidget.background": "#0E1116",
    "editorWidget.border": "#161B22",
    "editorSuggestWidget.background": "#0E1116",
    "editorSuggestWidget.border": "#161B22",
    "editorSuggestWidget.selectedBackground": "#0A84FF26",

    "menu.background": "#0E1116",
    "menu.foreground": "#E6EDF3",
    "menu.border": "#161B22",
    "menu.selectionBackground": "#0A84FF26",
    "menu.selectionForeground": "#E6EDF3",

    "notificationCenterHeader.background": "#0E1116",
    "notifications.background": "#0E1116",
    "notifications.border": "#161B22"
  },
  "tokenColors": [
    {
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": { "foreground": "#6E7681", "fontStyle": "italic" }
    },
    {
      "scope": ["string", "string.quoted"],
      "settings": { "foreground": "#A5D6FF" }
    },
    {
      "scope": ["constant.numeric", "constant.language", "constant.character"],
      "settings": { "foreground": "#79C0FF" }
    },
    {
      "scope": ["keyword", "storage", "storage.type"],
      "settings": { "foreground": "#FF7B72" }
    },
    {
      "scope": ["entity.name.function", "support.function"],
      "settings": { "foreground": "#D2A8FF" }
    },
    {
      "scope": ["entity.name.type", "entity.name.class", "support.type", "support.class"],
      "settings": { "foreground": "#FFA657" }
    },
    {
      "scope": ["variable", "variable.parameter"],
      "settings": { "foreground": "#E6EDF3" }
    },
    {
      "scope": ["punctuation", "meta.brace"],
      "settings": { "foreground": "#8B949E" }
    },
    {
      "scope": ["markup.heading"],
      "settings": { "foreground": "#79C0FF", "fontStyle": "bold" }
    },
    {
      "scope": ["markup.bold"],
      "settings": { "fontStyle": "bold" }
    },
    {
      "scope": ["markup.italic"],
      "settings": { "fontStyle": "italic" }
    }
  ]
}
