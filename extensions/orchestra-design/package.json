{
  "name": "orchestra-design",
  "displayName": "Orchestra Design",
  "description": "Design mode for the Division Designer role's design HTML (.division/design/*.html, one file per screen): live preview, page switching, visual editing, and AI edits that write back to the same HTML files.",
  "version": "0.1.0",
  "publisher": "orchestra",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "main": "./out/extension.js",
  "activationEvents": [
    "workspaceContains:**/.division/design/*.html",
    "workspaceContains:**/.division/DESIGN.html"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "In untrusted workspaces the design HTML's scripts are not run in the preview."
    }
  },
  "contributes": {
    "customEditors": [
      {
        "viewType": "orchestra.designEditor",
        "displayName": "Orchestra Design",
        "selector": [
          {
            "filenamePattern": "**/.division/design/*.html"
          },
          {
            "filenamePattern": "**/.division/DESIGN.html"
          }
        ],
        "priority": "default"
      }
    ],
    "commands": [
      {
        "command": "orchestra.design.open",
        "title": "Open Design in Design Mode",
        "category": "Orchestra Design",
        "icon": "$(paintcan)"
      },
      {
        "command": "orchestra.design.openAsText",
        "title": "Open Design Page as Code",
        "category": "Orchestra Design",
        "icon": "$(code)"
      },
      {
        "command": "orchestra.design.newPage",
        "title": "New Design Page",
        "category": "Orchestra Design",
        "icon": "$(add)"
      },
      {
        "command": "orchestra.design.setApiKey",
        "title": "Set Division API Key for AI Designer",
        "category": "Orchestra Design"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "orchestra.design.open",
          "when": "(resourcePath =~ /[\\\\/]\\.division[\\\\/]design[\\\\/][^\\\\/]+\\.html$/ || resourcePath =~ /[\\\\/]\\.division[\\\\/]DESIGN\\.html$/)",
          "group": "navigation"
        }
      ],
      "editor/title": [
        {
          "command": "orchestra.design.open",
          "when": "(resourcePath =~ /[\\\\/]\\.division[\\\\/]design[\\\\/][^\\\\/]+\\.html$/ || resourcePath =~ /[\\\\/]\\.division[\\\\/]DESIGN\\.html$/) && activeEditor == workbench.editors.files.textFileEditor",
          "group": "navigation"
        },
        {
          "command": "orchestra.design.openAsText",
          "when": "activeCustomEditorId == orchestra.designEditor",
          "group": "navigation"
        },
        {
          "command": "orchestra.design.newPage",
          "when": "activeCustomEditorId == orchestra.designEditor",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Orchestra Design",
      "properties": {
        "orchestraDesign.preview.runScripts": {
          "type": "boolean",
          "default": true,
          "description": "Run the design HTML's <script> elements in the preview. The preview is a sandboxed iframe with no access to the editor or extension APIs either way."
        },
        "orchestraDesign.designerModel": {
          "type": "string",
          "default": "",
          "description": "Model used by the AI Designer. Empty: use the model assigned to the Designer (design) role in Orchestra's Division settings."
        },
        "orchestraDesign.divisionEndpoint": {
          "type": "string",
          "default": "",
          "description": "Division API base URL. Empty: use Orchestra's Division API endpoint."
        },
        "orchestraDesign.notifyOnCreate": {
          "type": "boolean",
          "default": true,
          "description": "Offer to open Design mode when the Designer role creates new pages in .division/design/."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p .",
    "watch": "tsc -watch -p .",
    "test": "tsc -p . && node --test test/*.test.js"
  },
  "devDependencies": {
    "@types/node": "^18.0.0",
    "typescript": "^5.0.0"
  }
}
