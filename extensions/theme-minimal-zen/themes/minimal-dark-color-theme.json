{
	"$schema": "vscode://schemas/color-theme",
	"name": "Minimal Zen Dark",
	"type": "dark",
	"semanticHighlighting": true,
	"colors": {
		"foreground": "#e6edf3",
		"descriptionForeground": "#7d8590",
		"errorForeground": "#f85149",
		"focusBorder": "#30363d",
		"contrastBorder": "#00000000",
		"contrastActiveBorder": "#00000000",
		"widget.shadow": "#00000033",
		"widget.border": "#21262d",

		"editor.background": "#0d1117",
		"editor.foreground": "#e6edf3",
		"editor.lineHighlightBackground": "#161b22",
		"editor.lineHighlightBorder": "#00000000",
		"editor.selectionBackground": "#388bfd40",
		"editor.inactiveSelectionBackground": "#388bfd1f",
		"editor.findMatchBackground": "#9e6a0399",
		"editor.findMatchHighlightBackground": "#9e6a0340",
		"editorCursor.foreground": "#e6edf3",
		"editorWhitespace.foreground": "#21262d",
		"editorIndentGuide.background1": "#21262d",
		"editorIndentGuide.activeBackground1": "#30363d",
		"editorLineNumber.foreground": "#484f58",
		"editorLineNumber.activeForeground": "#e6edf3",
		"editorBracketMatch.background": "#388bfd33",
		"editorBracketMatch.border": "#00000000",
		"editorRuler.foreground": "#21262d",
		"editorOverviewRuler.border": "#00000000",
		"editorGutter.background": "#0d1117",

		"editorGroup.border": "#21262d",
		"editorGroupHeader.tabsBackground": "#0d1117",
		"editorGroupHeader.tabsBorder": "#21262d",
		"editorGroupHeader.border": "#00000000",
		"tab.activeBackground": "#0d1117",
		"tab.inactiveBackground": "#0d1117",
		"tab.activeForeground": "#e6edf3",
		"tab.inactiveForeground": "#7d8590",
		"tab.border": "#00000000",
		"tab.activeBorder": "#00000000",
		"tab.activeBorderTop": "#e6edf3",
		"tab.hoverBackground": "#161b22",
		"tab.unfocusedHoverBackground": "#161b22",

		"activityBar.background": "#0d1117",
		"activityBar.foreground": "#e6edf3",
		"activityBar.inactiveForeground": "#484f58",
		"activityBar.border": "#21262d",
		"activityBar.activeBorder": "#e6edf3",
		"activityBar.activeBackground": "#00000000",
		"activityBarBadge.background": "#e6edf3",
		"activityBarBadge.foreground": "#0d1117",

		"sideBar.background": "#0d1117",
		"sideBar.foreground": "#e6edf3",
		"sideBar.border": "#21262d",
		"sideBarTitle.foreground": "#7d8590",
		"sideBarSectionHeader.background": "#0d1117",
		"sideBarSectionHeader.foreground": "#7d8590",
		"sideBarSectionHeader.border": "#21262d",

		"list.activeSelectionBackground": "#161b22",
		"list.activeSelectionForeground": "#e6edf3",
		"list.inactiveSelectionBackground": "#161b22",
		"list.inactiveSelectionForeground": "#e6edf3",
		"list.hoverBackground": "#161b22",
		"list.focusBackground": "#161b22",
		"list.focusOutline": "#00000000",
		"list.highlightForeground": "#58a6ff",

		"statusBar.background": "#0d1117",
		"statusBar.foreground": "#7d8590",
		"statusBar.border": "#21262d",
		"statusBar.noFolderBackground": "#0d1117",
		"statusBar.debuggingBackground": "#0d1117",
		"statusBar.debuggingForeground": "#e6edf3",
		"statusBarItem.hoverBackground": "#161b22",
		"statusBarItem.remoteBackground": "#0d1117",
		"statusBarItem.remoteForeground": "#e6edf3",

		"titleBar.activeBackground": "#0d1117",
		"titleBar.activeForeground": "#e6edf3",
		"titleBar.inactiveBackground": "#0d1117",
		"titleBar.inactiveForeground": "#7d8590",
		"titleBar.border": "#21262d",

		"menu.background": "#0d1117",
		"menu.foreground": "#e6edf3",
		"menu.separatorBackground": "#21262d",
		"menu.border": "#21262d",

		"button.background": "#e6edf3",
		"button.foreground": "#0d1117",
		"button.hoverBackground": "#c9d1d9",
		"button.secondaryBackground": "#161b22",
		"button.secondaryForeground": "#e6edf3",
		"button.secondaryHoverBackground": "#21262d",

		"input.background": "#0d1117",
		"input.foreground": "#e6edf3",
		"input.border": "#30363d",
		"input.placeholderForeground": "#6e7681",
		"inputOption.activeBackground": "#388bfd33",
		"inputOption.activeBorder": "#58a6ff",
		"inputOption.activeForeground": "#58a6ff",

		"dropdown.background": "#0d1117",
		"dropdown.foreground": "#e6edf3",
		"dropdown.border": "#30363d",

		"badge.background": "#21262d",
		"badge.foreground": "#e6edf3",

		"scrollbar.shadow": "#00000000",
		"scrollbarSlider.background": "#e6edf31f",
		"scrollbarSlider.hoverBackground": "#e6edf333",
		"scrollbarSlider.activeBackground": "#e6edf34d",

		"panel.background": "#0d1117",
		"panel.border": "#21262d",
		"panelTitle.activeBorder": "#e6edf3",
		"panelTitle.activeForeground": "#e6edf3",
		"panelTitle.inactiveForeground": "#7d8590",

		"terminal.background": "#0d1117",
		"terminal.foreground": "#e6edf3",
		"terminalCursor.foreground": "#e6edf3",

		"breadcrumb.background": "#0d1117",
		"breadcrumb.foreground": "#7d8590",
		"breadcrumb.focusForeground": "#e6edf3",
		"breadcrumb.activeSelectionForeground": "#e6edf3",

		"editorWidget.background": "#0d1117",
		"editorWidget.border": "#21262d",
		"editorSuggestWidget.background": "#0d1117",
		"editorSuggestWidget.border": "#21262d",
		"editorSuggestWidget.selectedBackground": "#161b22",
		"editorHoverWidget.background": "#0d1117",
		"editorHoverWidget.border": "#21262d",

		"notifications.background": "#0d1117",
		"notifications.foreground": "#e6edf3",
		"notifications.border": "#21262d",
		"notificationCenterHeader.background": "#0d1117",
		"notificationCenterHeader.foreground": "#7d8590",

		"quickInput.background": "#0d1117",
		"quickInput.foreground": "#e6edf3",
		"pickerGroup.border": "#21262d",
		"pickerGroup.foreground": "#7d8590"
	},
	"tokenColors": [
		{
			"scope": ["comment", "punctuation.definition.comment"],
			"settings": { "foreground": "#7d8590", "fontStyle": "italic" }
		},
		{
			"scope": ["string", "string.quoted", "constant.other.symbol"],
			"settings": { "foreground": "#a5d6ff" }
		},
		{
			"scope": ["constant.numeric", "constant.language", "constant.character"],
			"settings": { "foreground": "#79c0ff" }
		},
		{
			"scope": ["keyword", "storage", "storage.type", "storage.modifier"],
			"settings": { "foreground": "#ff7b72" }
		},
		{
			"scope": ["entity.name.function", "support.function", "meta.function-call"],
			"settings": { "foreground": "#d2a8ff" }
		},
		{
			"scope": ["entity.name.class", "entity.name.type", "support.class", "support.type"],
			"settings": { "foreground": "#ffa657" }
		},
		{
			"scope": ["variable", "variable.other", "meta.definition.variable"],
			"settings": { "foreground": "#e6edf3" }
		},
		{
			"scope": ["variable.parameter"],
			"settings": { "foreground": "#c9d1d9" }
		},
		{
			"scope": ["entity.other.attribute-name", "entity.name.tag"],
			"settings": { "foreground": "#7ee787" }
		},
		{
			"scope": ["markup.heading", "entity.name.section"],
			"settings": { "foreground": "#79c0ff", "fontStyle": "bold" }
		},
		{
			"scope": ["markup.bold"],
			"settings": { "fontStyle": "bold" }
		},
		{
			"scope": ["markup.italic"],
			"settings": { "fontStyle": "italic" }
		}
	]
}
