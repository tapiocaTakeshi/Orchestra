		"input.placeholderForeground": "#8a7f75",
		"inputOption.activeBackground": "#a0803f26",
		"inputOption.activeBorder": "#a0803f99",
		"list.activeSelectionBackground": "#a0803f1f",
		"list.activeSelectionForeground": "#16110f",
		"list.dropBackground": "#a0803f1a",
		"list.focusBackground": "#a0803f17",
		"list.focusOutline": "#a0803f66",
		"list.highlightForeground": "#7d6230",
