		"scrollbarSlider.background": "#8a7f7533",
		"scrollbarSlider.hoverBackground": "#8a7f7555",
		"selection.background": "#a0803f40",
		"settings.modifiedItemIndicator": "#a0803f",
		"sideBar.background": "#f6f1e9",
		"sideBar.border": "#e8e0d3",
		"sideBar.foreground": "#554b44",
		"sideBarSectionHeader.background": "#f6f1e9",
		"sideBarSectionHeader.border": "#e8e0d3",
		"sideBarSectionHeader.foreground": "#554b44",
		"sideBarTitle.foreground": "#554b44",
		"statusBar.background": "#f6f1e9",
		"statusBar.border": "#e8e0d3",
		"statusBar.debuggingBackground": "#a8741f",
		"statusBar.debuggingForeground": "#fffaf2",
		"statusBar.foreground": "#8a7f75",
		"statusBar.noFolderBackground": "#f6f1e9",
		"statusBarItem.hoverBackground": "#efe8dc",
		"statusBarItem.remoteBackground": "#8a1a2a",
		"statusBarItem.remoteForeground": "#fffaf2",
