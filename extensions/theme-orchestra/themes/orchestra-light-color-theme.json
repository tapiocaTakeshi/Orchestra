{
	"$schema": "vscode://schemas/color-theme",
	"name": "Orchestra Light",
	"type": "light",
	"colors": {
		"activityBar.activeBorder": "#e02431",
		"activityBar.background": "#faf8f8",
		"activityBar.border": "#ece7e7",
		"activityBar.foreground": "#1c1416",
		"activityBar.inactiveForeground": "#6d6165",
		"activityBarBadge.background": "#e02431",
		"activityBarBadge.foreground": "#ffffff",
		"badge.background": "#e02431",
		"badge.foreground": "#ffffff",
		"button.background": "#e02431",
		"button.foreground": "#ffffff",
		"button.hoverBackground": "#c4182a",
		"button.secondaryBackground": "#f1eaea",
		"button.secondaryForeground": "#1c1416",
		"button.secondaryHoverBackground": "#e6dcdd",
		"checkbox.background": "#ffffff",
		"checkbox.border": "#ddd4d5",
		"diffEditor.insertedTextBackground": "#14b87a22",
		"diffEditor.removedTextBackground": "#e0243122",
		"dropdown.background": "#ffffff",
		"dropdown.border": "#ddd4d5",
		"dropdown.foreground": "#1c1416",
		"editor.background": "#ffffff",
		"editor.findMatchBackground": "#f79aa266",
		"editor.findMatchHighlightBackground": "#f79aa233",
		"editor.foreground": "#2b2023",
		"editor.inactiveSelectionBackground": "#fde3e566",
		"editor.lineHighlightBackground": "#faf8f8",
		"editor.selectionBackground": "#fbc5c988",
		"editor.selectionHighlightBackground": "#fbc5c944",
		"editor.wordHighlightBackground": "#fde3e588",
		"editorBracketMatch.background": "#fde3e5",
		"editorBracketMatch.border": "#e02431",
		"editorCursor.foreground": "#c4182a",
		"editorGroup.border": "#ece7e7",
		"editorGroupHeader.tabsBackground": "#faf8f8",
		"editorGroupHeader.tabsBorder": "#ece7e7",
		"editorGutter.addedBackground": "#14b87a",
		"editorGutter.deletedBackground": "#e02431",
		"editorGutter.modifiedBackground": "#f5a524",
		"editorIndentGuide.activeBackground1": "#ddd4d5",
		"editorIndentGuide.background1": "#f1eaea",
		"editorLineNumber.activeForeground": "#c4182a",
		"editorLineNumber.foreground": "#b3a4a7",
		"editorLink.activeForeground": "#c4182a",
		"editorWhitespace.foreground": "#e6dcdd",
		"editorWidget.background": "#faf8f8",
		"editorWidget.border": "#ece7e7",
		"focusBorder": "#e02431",
		"input.background": "#ffffff",
		"input.border": "#ddd4d5",
		"input.foreground": "#1c1416",
		"input.placeholderForeground": "#998d90",
		"inputOption.activeBackground": "#fde3e5",
		"inputOption.activeBorder": "#e02431",
		"list.activeSelectionBackground": "#fde3e5",
		"list.activeSelectionForeground": "#1c1416",
		"list.dropBackground": "#fde3e588",
		"list.focusBackground": "#fde3e5aa",
		"list.highlightForeground": "#c4182a",
		"list.hoverBackground": "#faf8f8",
		"list.inactiveSelectionBackground": "#f1eaea",
		"menu.background": "#ffffff",
		"menu.foreground": "#1c1416",
		"menu.selectionBackground": "#fde3e5",
		"minimap.findMatchHighlight": "#e02431",
		"minimap.selectionHighlight": "#fbc5c9",
		"notificationCenterHeader.background": "#faf8f8",
		"notifications.background": "#ffffff",
		"notifications.border": "#ece7e7",
		"panel.background": "#ffffff",
		"panel.border": "#ece7e7",
		"panelTitle.activeBorder": "#e02431",
		"panelTitle.activeForeground": "#1c1416",
		"panelTitle.inactiveForeground": "#6d6165",
		"peekView.border": "#e02431",
		"peekViewEditor.background": "#faf8f8",
		"peekViewResult.background": "#ffffff",
		"pickerGroup.border": "#ece7e7",
		"pickerGroup.foreground": "#c4182a",
		"progressBar.background": "#e02431",
		"quickInputList.focusBackground": "#fde3e5",
		"scrollbarSlider.activeBackground": "#e0243155",
		"scrollbarSlider.background": "#ddd4d566",
		"scrollbarSlider.hoverBackground": "#ddd4d5aa",
		"selection.background": "#fbc5c988",
		"settings.modifiedItemIndicator": "#e02431",
		"sideBar.background": "#faf8f8",
		"sideBar.border": "#ece7e7",
		"sideBar.foreground": "#4a3f42",
		"sideBarSectionHeader.background": "#f1eaea",
		"sideBarSectionHeader.border": "#ece7e7",
		"sideBarSectionHeader.foreground": "#4a3f42",
		"sideBarTitle.foreground": "#4a3f42",
		"statusBar.background": "#e02431",
		"statusBar.border": "#c4182a",
		"statusBar.debuggingBackground": "#f5a524",
		"statusBar.debuggingForeground": "#1c1416",
		"statusBar.foreground": "#ffffff",
		"statusBar.noFolderBackground": "#a31423",
		"statusBarItem.remoteBackground": "#a31423",
		"statusBarItem.remoteForeground": "#ffffff",
		"tab.activeBackground": "#ffffff",
		"tab.activeBorderTop": "#e02431",
		"tab.activeForeground": "#1c1416",
		"tab.border": "#ece7e7",
		"tab.hoverBackground": "#faf8f8",
		"tab.inactiveBackground": "#faf8f8",
		"tab.inactiveForeground": "#6d6165",
		"terminal.ansiBrightRed": "#ef5f6b",
		"terminal.ansiRed": "#c4182a",
		"terminalCursor.foreground": "#c4182a",
		"textLink.activeForeground": "#a31423",
		"textLink.foreground": "#c4182a",
		"titleBar.activeBackground": "#faf8f8",
		"titleBar.activeForeground": "#1c1416",
		"titleBar.border": "#ece7e7",
		"titleBar.inactiveBackground": "#faf8f8",
		"titleBar.inactiveForeground": "#998d90",
		"welcomePage.tileBackground": "#faf8f8",
		"widget.shadow": "#1c141622"
	},
	"tokenColors": [
		{
			"scope": ["comment", "punctuation.definition.comment"],
			"settings": { "foreground": "#9a8489", "fontStyle": "italic" }
		},
		{
			"scope": ["string", "string.quoted"],
			"settings": { "foreground": "#b25e09" }
		},
		{
			"scope": ["constant.numeric", "constant.language", "constant.character"],
			"settings": { "foreground": "#a31423" }
		},
		{
			"scope": ["keyword", "storage.type", "storage.modifier", "keyword.control"],
			"settings": { "foreground": "#c4182a" }
		},
		{
			"scope": ["entity.name.function", "support.function", "meta.function-call.generic"],
			"settings": { "foreground": "#8a5a00" }
		},
		{
			"scope": ["entity.name.type", "entity.name.class", "support.type", "support.class"],
			"settings": { "foreground": "#0e7a5f" }
		},
		{
			"scope": ["variable", "meta.definition.variable.name", "support.variable"],
			"settings": { "foreground": "#2b2023" }
		},
		{
			"scope": ["variable.other.property", "support.type.property-name"],
			"settings": { "foreground": "#4a3f42" }
		},
		{
			"scope": ["entity.name.tag"],
			"settings": { "foreground": "#c4182a" }
		},
		{
			"scope": ["entity.other.attribute-name"],
			"settings": { "foreground": "#b25e09" }
		},
		{
			"scope": ["markup.heading", "markup.bold"],
			"settings": { "foreground": "#c4182a", "fontStyle": "bold" }
		},
		{
			"scope": ["markup.italic"],
			"settings": { "fontStyle": "italic" }
		},
		{
			"scope": ["invalid", "invalid.illegal"],
			"settings": { "foreground": "#ffffff", "background": "#e02431" }
		}
	]
}
