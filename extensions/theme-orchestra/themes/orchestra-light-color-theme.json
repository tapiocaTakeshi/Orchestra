		"terminal.ansiBrightYellow": "#7d6230",
		"terminal.ansiRed": "#8a1a2a",
		"terminal.ansiYellow": "#a0803f",
		"terminalCursor.foreground": "#a0803f",
		"textLink.activeForeground": "#8a1a2a",
		"textLink.foreground": "#7d6230",
		"titleBar.activeBackground": "#f6f1e9",
		"titleBar.activeForeground": "#231d1a",
		"titleBar.border": "#e8e0d3",
		"titleBar.inactiveBackground": "#f6f1e9",
		"titleBar.inactiveForeground": "#8a7f75",
		"welcomePage.tileBackground": "#ffffff",
		"widget.border": "#e8e0d3",
		"widget.shadow": "#2a1d1426"
	},
	"tokenColors": [
		{
			"scope": [
				"comment",
				"punctuation.definition.comment"
			],
			"settings": {
				"foreground": "#9a8e82",
				"fontStyle": "italic"
			}
		},
		{
			"scope": [
				"string",
				"string.quoted"
			],
			"settings": {
				"foreground": "#8a6424"
			}
		},
		{
			"scope": [
				"constant.numeric",
				"constant.language",
				"constant.character"
			],
			"settings": {
				"foreground": "#8a1a2a"
			}
		},
		{
			"scope": [
				"keyword",
				"storage.type",
				"storage.modifier",
				"keyword.control"
			],
			"settings": {
				"foreground": "#9e2535"
			}
		},
		{
			"scope": [
				"entity.name.function",
				"support.function",
				"meta.function-call.generic"
			],
			"settings": {
				"foreground": "#6e5320"
			}
		},
		{
			"scope": [
				"entity.name.type",
				"entity.name.class",
				"support.type",
				"support.class"
			],
			"settings": {
				"foreground": "#2f6b56"
			}
		},
		{
			"scope": [
				"variable",
				"meta.definition.variable.name",
				"support.variable"
			],
			"settings": {
				"foreground": "#231d1a"
			}
		},
		{
			"scope": [
				"variable.other.property",
				"support.type.property-name"
			],
			"settings": {
				"foreground": "#554b44"
			}
		},
		{
			"scope": [
				"entity.name.tag"
			],
			"settings": {
				"foreground": "#9e2535"
			}
		},
		{
			"scope": [
				"entity.other.attribute-name"
			],
			"settings": {
				"foreground": "#8a6424"
			}
		},
		{
			"scope": [
				"markup.heading",
				"markup.bold"
			],
			"settings": {
				"foreground": "#8a1a2a",
				"fontStyle": "bold"
			}
		},
		{
			"scope": [
				"markup.italic"
			],
			"settings": {
				"fontStyle": "italic"
			}
		},
		{
			"scope": [
				"invalid",
				"invalid.illegal"
			],
			"settings": {
				"foreground": "#fffaf2",
				"background": "#8a1a2a"
			}
		}
	]
}
