{
	"$schema": "vscode://schemas/color-theme",
	"name": "Orchestra Dark",
	"type": "dark",
	"colors": {
		"activityBar.activeBorder": "#e02431",
		"activityBar.background": "#1d0e11",
		"activityBar.border": "#3b2228",
		"activityBar.foreground": "#f6eeef",
		"activityBar.inactiveForeground": "#997f85",
		"activityBarBadge.background": "#e02431",
		"activityBarBadge.foreground": "#ffffff",
		"badge.background": "#e02431",
		"badge.foreground": "#ffffff",
		"button.background": "#e02431",
		"button.foreground": "#ffffff",
		"button.hoverBackground": "#c4182a",
		"button.secondaryBackground": "#3b2228",
		"button.secondaryForeground": "#f6eeef",
		"button.secondaryHoverBackground": "#543038",
		"checkbox.background": "#241317",
		"checkbox.border": "#543038",
		"debugToolBar.background": "#241317",
		"diffEditor.insertedTextBackground": "#14b87a26",
