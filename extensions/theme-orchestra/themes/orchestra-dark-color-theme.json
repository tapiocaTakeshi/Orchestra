		"editorGroupHeader.tabsBorder": "#3b2228",
		"editorGutter.addedBackground": "#14b87a",
		"editorGutter.deletedBackground": "#e02431",
		"editorGutter.modifiedBackground": "#f5a524",
		"editorIndentGuide.activeBackground1": "#543038",
		"editorIndentGuide.background1": "#2c181d",
		"editorLineNumber.activeForeground": "#f79aa2",
		"editorLineNumber.foreground": "#6d5257",
		"editorLink.activeForeground": "#f79aa2",
		"editorWhitespace.foreground": "#3b2228",
		"editorWidget.background": "#241317",
		"editorWidget.border": "#3b2228",
		"focusBorder": "#e02431",
		"input.background": "#241317",
		"input.border": "#543038",
		"input.foreground": "#f6eeef",
		"input.placeholderForeground": "#997f85",
		"inputOption.activeBackground": "#e0243144",
		"inputOption.activeBorder": "#e02431",
		"list.activeSelectionBackground": "#7c2a3444",
		"list.activeSelectionForeground": "#ffffff",
		"list.dropBackground": "#e0243126",
		"list.focusBackground": "#7c2a3433",
		"list.highlightForeground": "#f79aa2",
		"list.hoverBackground": "#241317",
		"list.inactiveSelectionBackground": "#2c181d",
		"menu.background": "#241317",
		"menu.foreground": "#f6eeef",
		"menu.selectionBackground": "#7c2a3444",
		"minimap.findMatchHighlight": "#e02431",
		"minimap.selectionHighlight": "#7c2a34",
		"notificationCenterHeader.background": "#241317",
		"notifications.background": "#241317",
		"notifications.border": "#3b2228",
		"panel.background": "#16090b",
		"panel.border": "#3b2228",
		"panelTitle.activeBorder": "#e02431",
		"panelTitle.activeForeground": "#f6eeef",
		"panelTitle.inactiveForeground": "#997f85",
		"peekView.border": "#e02431",
		"peekViewEditor.background": "#1d0e11",
		"peekViewResult.background": "#241317",
		"pickerGroup.border": "#3b2228",
		"pickerGroup.foreground": "#f79aa2",
		"progressBar.background": "#e02431",
		"quickInputList.focusBackground": "#7c2a3444",
		"scrollbarSlider.activeBackground": "#e0243166",
		"scrollbarSlider.background": "#54303855",
		"scrollbarSlider.hoverBackground": "#54303899",
		"selection.background": "#7c2a3466",
		"settings.modifiedItemIndicator": "#e02431",
		"sideBar.background": "#1d0e11",
		"sideBar.border": "#3b2228",
		"sideBar.foreground": "#d9c8cb",
		"sideBarSectionHeader.background": "#241317",
		"sideBarSectionHeader.border": "#3b2228",
		"sideBarSectionHeader.foreground": "#d9c8cb",
		"sideBarTitle.foreground": "#d9c8cb",
		"statusBar.background": "#a31423",
		"statusBar.border": "#a31423",
		"statusBar.debuggingBackground": "#f5a524",
		"statusBar.debuggingForeground": "#1c1416",
		"statusBar.foreground": "#ffffff",
		"statusBar.noFolderBackground": "#731520",
		"statusBarItem.remoteBackground": "#731520",
		"statusBarItem.remoteForeground": "#ffffff",
		"tab.activeBackground": "#16090b",
		"tab.activeBorderTop": "#e02431",
		"tab.activeForeground": "#ffffff",
		"tab.border": "#3b2228",
		"tab.hoverBackground": "#241317",
		"tab.inactiveBackground": "#1d0e11",
		"tab.inactiveForeground": "#997f85",
		"terminal.ansiBrightRed": "#ef5f6b",
		"terminal.ansiRed": "#e02431",
		"terminalCursor.foreground": "#ef5f6b",
		"textLink.activeForeground": "#f79aa2",
		"textLink.foreground": "#ef5f6b",
		"titleBar.activeBackground": "#1d0e11",
		"titleBar.activeForeground": "#f6eeef",
		"titleBar.border": "#3b2228",
		"titleBar.inactiveBackground": "#16090b",
		"titleBar.inactiveForeground": "#997f85",
		"welcomePage.tileBackground": "#241317",
		"widget.shadow": "#00000066"
	},
	"tokenColors": [
		{
			"scope": ["comment", "punctuation.definition.comment"],
			"settings": { "foreground": "#8a7075", "fontStyle": "italic" }
		},
		{
			"scope": ["string", "string.quoted"],
			"settings": { "foreground": "#f5a55e" }
		},
		{
			"scope": ["constant.numeric", "constant.language", "constant.character"],
			"settings": { "foreground": "#f79aa2" }
		},
		{
			"scope": ["keyword", "storage.type", "storage.modifier", "keyword.control"],
			"settings": { "foreground": "#ef5f6b" }
		},
		{
			"scope": ["entity.name.function", "support.function", "meta.function-call.generic"],
			"settings": { "foreground": "#f0c987" }
		},
		{
			"scope": ["entity.name.type", "entity.name.class", "support.type", "support.class"],
			"settings": { "foreground": "#7fd1b9" }
		},
		{
			"scope": ["variable", "meta.definition.variable.name", "support.variable"],
			"settings": { "foreground": "#f0e4e5" }
		},
		{
			"scope": ["variable.other.property", "support.type.property-name"],
			"settings": { "foreground": "#d9c8cb" }
		},
		{
			"scope": ["entity.name.tag"],
			"settings": { "foreground": "#ef5f6b" }
		},
		{
			"scope": ["entity.other.attribute-name"],
			"settings": { "foreground": "#f5a55e" }
		},
		{
			"scope": ["markup.heading", "markup.bold"],
			"settings": { "foreground": "#ef5f6b", "fontStyle": "bold" }
		},
		{
			"scope": ["markup.italic"],
			"settings": { "fontStyle": "italic" }
		},
		{
			"scope": ["invalid", "invalid.illegal"],
			"settings": { "foreground": "#ffffff", "background": "#e02431" }
		}
	]
}
